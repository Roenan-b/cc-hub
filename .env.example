# Copy to .env (scripts/start.sh does this and fills in secrets on first run).

# ---- Access ---------------------------------------------------------------
# Admin login: full control (chat, spawn, approve). Treat it like an SSH key.
HUB_UI_TOKEN=
# Optional read-only dashboard login, safe to share. Leave empty to disable.
HUB_OBSERVER_TOKEN=
# Let observers read message text (default: they see metadata only).
HUB_OBSERVER_READ_MESSAGES=0

# ---- Database ---------------------------------------------------------------
# 1 = start Postgres with Docker (docker-compose.yml, port 5433); 0 = use a local Postgres service.
CCHUB_DOCKER_DB=1
POSTGRES_PASSWORD=
DATABASE_URL=postgres://cchub:CHANGE_ME@127.0.0.1:5433/cchub

# ---- Network ----------------------------------------------------------------
# Keep 127.0.0.1 and put Tailscale or Cloudflare Tunnel in front (docs/DEPLOY.md).
HUB_HOST=127.0.0.1
HUB_PORT=8787
# 1 when behind a reverse proxy you control (tailscale serve, cloudflared).
HUB_TRUST_PROXY=0

# ---- Workspace ----------------------------------------------------------------
# Sessions may only start in directories under these roots (colon-separated).
HUB_WORKSPACE_ROOTS=~/projects
# Obsidian vault shared by all sessions. Created from vault-template/ if missing.
HUB_VAULT=~/Vault
# Commit vault changes to git every N minutes (0 disables).
HUB_VAULT_AUTOCOMMIT_MIN=5
# Each project gets a working folder here (must be inside a workspace root).
# Default: <first workspace root>/cc-projects
# HUB_PROJECTS_DIR=
# Optional: sync the vault with a PRIVATE git repo on every commit (e.g. git@github.com:you/vault.git),
# so Obsidian on your laptop and phone sees what agents write on the server.
HUB_VAULT_REMOTE=

# ---- Team behavior ----------------------------------------------------------
HUB_AUTOSTART_ORCHESTRATOR=1
# After the machine was off or asleep and sessions died, restart the workers that
# were running and brief the lead.
HUB_RESUME_ON_BOOT=1
HUB_MAX_WORKERS=6
# Lead gets a board check-in this often while work is in flight (minutes).
HUB_HEARTBEAT_MIN=15
# A session with no terminal or hub activity this long counts as stalled (minutes).
HUB_STALL_MIN=30
# Local hour (0-23) the lead writes the daily report; -1 disables.
HUB_DIGEST_HOUR=21
# Peer messages per session per minute (loop guard).
HUB_PEER_RATE_LIMIT=20
# ---- Live agent view ---------------------------------------------------------
# Record each tool call (name + one-line preview, secrets masked) through a Claude Code hook. 0 disables.
HUB_ACTIVITY_HOOKS=1
# How often the hub reads the hook's activity files (seconds).
HUB_ACTIVITY_POLL_SEC=2
# Tool-call events are deleted after this many days; other events are kept.
HUB_EVENT_RETENTION_DAYS=30
# share_progress posts per session per minute.
HUB_PROGRESS_RATE_LIMIT=30

# Offer bypassPermissions mode. Only inside a container or VM.
HUB_ALLOW_BYPASS=0

# CLAUDE_BIN=claude
# HUB_STATE_DIR=~/.cc-hub
# HUB_TMUX_SOCKET=          # run sessions on a dedicated tmux server

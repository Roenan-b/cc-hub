{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": {
      "allowed_elements": [
        "p",
        "img",
        "a",
        "br",
        "picture",
        "source",
        "details",
        "summary",
        "div",
        "sub",
        "sup",
        "kbd",
      ],
    },
    "MD041": false,
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "vault-template/**", "roles/**", "orchestrator/**", "CHANGELOG.md"],
}
